# Loads uploaded CSVs, performs statistical analysis, and outputs results
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
import statsmodels.formula.api as smf
# Step 1: Load datasets
# Update these paths to match your local folder in VS Code
sales = pd.read_csv("sales_data.csv")
churn = pd.read_csv("customer_churn.csv")

# Step 2: Descriptive Statistics
print("=== Descriptive Statistics (Sales) ===")
print(sales["Total_Sales"].describe())
print("\nMean:", sales["Total_Sales"].mean())
print("Median:", sales["Total_Sales"].median())
print("Mode:", sales["Total_Sales"].mode()[0])
print("Standard Deviation:", sales["Total_Sales"].std())

# Step 3: Data Distribution Analysis
plt.figure(figsize=(8,5))
sns.histplot(sales["Total_Sales"], kde=True, bins=20, color="skyblue")
plt.title("Sales Distribution")
plt.xlabel("Total Sales")
plt.ylabel("Frequency")
plt.show()

# Normality test
stat, p = stats.shapiro(sales["Total_Sales"])
print("\nShapiro-Wilk Test for Normality: p =", p)

# Step 4: Correlation Analysis
# Example: Correlation between Quantity and Total_Sales
corr = sales["Quantity"].corr(sales["Total_Sales"])
print("\nCorrelation (Quantity vs Total_Sales):", corr)

plt.figure(figsize=(6,6))
sns.heatmap(sales[["Quantity","Price","Total_Sales"]].corr(), annot=True, cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()

# Step 5: Hypothesis Testing
# Example: Compare Sales between East vs West regions
east_sales = sales[sales["Region"]=="East"]["Total_Sales"]
west_sales = sales[sales["Region"]=="West"]["Total_Sales"]

t_stat, p_val = stats.ttest_ind(east_sales, west_sales, equal_var=False)
print("\nT-test (East vs West Sales): t =", t_stat, ", p =", p_val)

# ANOVA across all regions
anova = stats.f_oneway(
    sales[sales["Region"]=="North"]["Total_Sales"],
    sales[sales["Region"]=="South"]["Total_Sales"],
    sales[sales["Region"]=="East"]["Total_Sales"],
    sales[sales["Region"]=="West"]["Total_Sales"]
)
print("ANOVA across regions: F =", anova.statistic, ", p =", anova.pvalue)

# Chi-square test on churn data (Contract vs Churn)
contingency = pd.crosstab(churn["Contract"], churn["Churn"])
chi2, p_chi, _, _ = stats.chi2_contingency(contingency)
print("Chi-square test (Contract vs Churn): chi2 =", chi2, ", p =", p_chi)

# Step 6: Confidence Intervals
mean_sales = sales["Total_Sales"].mean()
sem_sales = stats.sem(sales["Total_Sales"])
ci = stats.t.interval(0.95, len(sales["Total_Sales"])-1, loc=mean_sales, scale=sem_sales)
print("\n95% Confidence Interval for Average Sales:", ci)

# Step 7: Regression Analysis
# Example: Regression of Total_Sales ~ Quantity + Price
model = smf.ols("Total_Sales ~ Quantity + Price", data=sales).fit()
print("\n=== Regression Summary ===")
print(model.summary())

# Plot regression line (simplified: Quantity vs Total_Sales)
plt.figure(figsize=(8,6))
sns.scatterplot(x="Quantity", y="Total_Sales", data=sales, color="blue")
sns.regplot(x="Quantity", y="Total_Sales", data=sales, scatter=False, color="red")
plt.title("Regression: Total_Sales vs Quantity")
plt.show()

# Step 8: Business Insights
print("\n=== Business Insights ===")
print(f"Average Sales: ${mean_sales:,.0f} ± {ci[1]-mean_sales:,.0f} (95% CI)")
print(f"Correlation (Quantity-Total_Sales): {corr:.2f} ({'Strong' if abs(corr)>0.7 else 'Weak'})")
print(f"Regression shows Quantity & Price significantly affect sales: "
      f"{'✓ SIGNIFICANT' if model.pvalues['Quantity']<0.05 or model.pvalues['Price']<0.05 else '✗ Not Significant'}")
